NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://splinance:splinance@localhost:5432/splinance

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS); false for local http.
COOKIE_SECURE=false
