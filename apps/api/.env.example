NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://splinance:splinance@localhost:5432/splinance
# Migrations as the schema owner when the API's own role has no DDL rights (production).
# MIGRATE_DATABASE_URL=postgres://splinance_owner:...@host:5432/splinance

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (HTTPS); false for local http.
COOKIE_SECURE=false

# Demo instance only (its own database, name ending in _demo): "Try the demo" sandboxes.
# DEMO_MODE=true
# DEMO_TTL_DAYS=7
# DEMO_MAX_ACTIVE=200

# Reverse proxies in front of the API whose X-Forwarded-For is trusted (0 = none, local dev).
# TRUST_PROXY=1
# Who may create an account: open (default here), allowlist, closed (default in production).
# REGISTRATION=allowlist
# REGISTRATION_ALLOWLIST=you@example.com,partner@example.com

# Sign in with Google (optional; never on the demo instance). APP_ORIGIN is where the browser
# reaches the app: the redirect URI is APP_ORIGIN/api/auth/oauth/google/callback.
# APP_ORIGIN=http://localhost:5173
# OAUTH_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# OAUTH_GOOGLE_CLIENT_SECRET=...
# OAUTH_GOOGLE_ISSUER=https://accounts.google.com
