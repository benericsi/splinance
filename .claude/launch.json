{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/api", "dev"],
      "port": 3000
    },
    {
      "name": "fake-oidc",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/fake-oidc", "start"],
      "port": 3301,
      "env": {
        "PORT": "3301",
        "FAKE_OIDC_CLIENT_ID": "dev-client",
        "FAKE_OIDC_CLIENT_SECRET": "dev-secret",
        "FAKE_OIDC_ISSUER_HOST": "127.0.0.1"
      }
    },
    {
      "name": "api-fake-google",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/api", "dev"],
      "port": 3000,
      "env": {
        "APP_ORIGIN": "http://localhost:5173",
        "OAUTH_GOOGLE_CLIENT_ID": "dev-client",
        "OAUTH_GOOGLE_CLIENT_SECRET": "dev-secret",
        "OAUTH_GOOGLE_ISSUER": "http://127.0.0.1:3301"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/web", "dev"],
      "port": 5173
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/api", "dev"],
      "port": 3200,
      "env": {
        "PORT": "3200",
        "DEMO_MODE": "true",
        "APP_ORIGIN": "http://localhost:5174",
        "DATABASE_URL": "postgres://splinance:splinance@localhost:5432/splinance_demo"
      }
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@splinance/web", "dev:demo"],
      "port": 5174,
      "env": { "API_PROXY_TARGET": "http://localhost:3200" }
    },
    {
      "name": "web-running",
      "url": "http://check.localhost:5173",
      "port": 5173
    }
  ]
}
